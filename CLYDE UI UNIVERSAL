-- ESP Logic (using Highlights)
local function createHighlight(instance, color)
    if not instance then return end
    local hl = Instance.new("Highlight")
    hl.Parent = instance
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.new(1,1,1)
    table.insert(espObjects, hl)
end

local function clearESP()
    for _, v in pairs(espObjects) do
        if v and v.Parent then v:Destroy() end
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if Toggles.PlayerESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                createHighlight(p.Character, Color3.fromRGB(255, 0, 0))
            end
        end
    end
    if Toggles.ItemESP then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") then
                -- Attach highlight to the Handle or a base part inside the tool so it renders
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    createHighlight(handle, Color3.fromRGB(0, 255, 0))
                end
            end
        end
    end
    if Toggles.EntityESP then
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                createHighlight(obj, Color3.fromRGB(255, 150, 0))
            end
        end
    end
end

