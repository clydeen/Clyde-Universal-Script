CreateButton(tabs.Teleport, "Teleport to Player", function()
    if targetPlrName == "" or targetPlrName == "Type name..." then 
        TpStatus.Text = "Status: Enter a name!" 
        return 
    end
    
    local lowerInput = string.lower(targetPlrName)
    local foundPlayer = nil
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.sub(string.lower(p.Name), 1, #lowerInput) == lowerInput or string.find(string.lower(p.DisplayName), lowerInput) then
                foundPlayer = p
                break
            end
        end
    end
    
    if foundPlayer and foundPlayer.Character and foundPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = foundPlayer.Character.HumanoidRootPart.CFrame
            TpStatus.Text = "Status: TP'd to " .. foundPlayer.Name
        end
    else
        TpStatus.Text = "Status: Player not found/dead"
    end
end, Color3.fromRGB(150, 100, 255))

