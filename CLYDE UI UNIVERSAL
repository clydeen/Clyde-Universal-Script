-- Event Listeners
Players.PlayerAdded:Connect(function(player)
    if Toggles.AutoLeave then
        -- Simple check for admin keywords or group rank
        local nameLower = string.lower(player.Name)
        if string.find(nameLower, "admin") or string.find(nameLower, "mod") then
            LocalPlayer:Kick("Auto Leave Triggered: Potential Admin/Moderator Joined ("..player.Name..")")
        end
    end
    if Toggles.PlayerESP then
        task.wait(1)
        updateESP()
    end
end)
